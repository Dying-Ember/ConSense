# Deployment template only. Paths below are inside the Source container.
# Prepare the listed files and distinct writable state directories before creation.
CONSENSE_WORKSPACE_ROOT=<existing-container-workspace-absolute-path>
CONSENSE_SL_SCOPE_MANIFEST=/runtime/config/sl-scope.json
CONSENSE_SOURCE_VETTING_STATE=/runtime/state/vetting
CONSENSE_SOURCE_ADVISORY_STATE=/runtime/state/advisory
CONSENSE_SOURCE_VETTING_PORT=28681
CONSENSE_SOURCE_ADVISORY_PORT=28685
CONSENSE_QDRANT_URL=http://127.0.0.1:28683
# Use an independently provisioned 0600 secret file; never place the key here.
CONSENSE_QDRANT_API_KEY_FILE=<container-secret-file-absolute-path>
# Bind these paths to the final configuration and calculate the matching hashes.
CONSENSE_COMPLETE_OCR_CONFIG=<container-ocr-config-absolute-path>
CONSENSE_COMPLETE_OCR_CONFIG_SHA256=<sha256-of-final-ocr-config>
CONSENSE_MODEL_DEVICE=cuda
CONSENSE_FIXED_GPU_URL=unix:///<container-private-socket-path>
CONSENSE_FIXED_GPU_TOKEN_FILE=<container-gpu-secret-file-absolute-path>
CONSENSE_FIXED_GPU_TIMEOUT_SECONDS=<actual-positive-timeout-seconds>
CONSENSE_FIXED_GPU_CONFIG_SHA256=<sha256-of-final-gpu-config>
CONSENSE_FIXED_GPU_PROFILE_MANIFEST=<container-gpu-profile-absolute-path>
CONSENSE_FIXED_GPU_PROFILE_MANIFEST_SHA256=<sha256-of-final-gpu-profile>
