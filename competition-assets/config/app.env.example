# Deployment template only. Fill in the placeholders before creating the container.
# The real env file contains credentials; keep it outside version control.
SPRING_PROFILES_ACTIVE=h2,competition
CONSENSE_QWEN_ENABLED=true
CONSENSE_QWEN_MODEL=qwen3.8-27b
# vLLM base URL without /v1; the client adds the API path.
CONSENSE_QWEN_BASE_URL=http://<actual-vllm-host-and-port>
CONSENSE_QWEN_API_KEY=<provide-separately>
CONSENSE_H2_JDBC_URL=jdbc:h2:tcp://127.0.0.1:28682/<database-path>
SPRING_DATASOURCE_PASSWORD=<provide-separately>
CONSENSE_VECTOR_BASE_URL=http://127.0.0.1:28683
CONSENSE_VECTOR_API_KEY=<provide-separately>
CONSENSE_OCR_ENABLED=true
CONSENSE_OCR_MODE=local
CONSENSE_OCR_BASE_URL=http://127.0.0.1:28681
APP_JAR=app.jar
APP_WEB_DIRECTORY=web
APP_RELEASE_DIRECTORY=.
APP_RELEASE_FILES_SHA256=<sha256-of-this-release-files-manifest>
APP_CONTENT_MANIFEST_SHA256=<sha256-of-this-release-sha256sums>
